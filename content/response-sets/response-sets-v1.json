        { "id": "reposition", "any_of": ["reposition", "re-position", "move the stethoscope", "check placement"] },
        { "id": "reinflate_after_deflation", "any_of": ["deflate fully and retry", "start again", "repeat the measurement", "fully deflate then"] },
        { "id": "check_equipment", "any_of": ["check the earpieces", "check the tubing", "check equipment", "check the stethoscope"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "E1_classification",
      "version": "1",
      "required_concepts": [
        { "id": "names_category", "any_of": ["normal", "elevated", "stage one", "stage 1", "stage two", "stage 2", "crisis", "hypotension", "hypotensive"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "E2_repeat_requirement",
      "version": "1",
      "required_concepts": [
        { "id": "single_reading_insufficient", "any_of": ["single reading", "one reading is not", "does not establish", "not a diagnosis"] },
        { "id": "repeat", "any_of": ["repeat", "second reading", "confirm", "another reading", "follow up"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },

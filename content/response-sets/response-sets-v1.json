        { "id": "names_choice", "any_of": ["chose the", "i would use", "selected the", "pick the"] },
        { "id": "residual_uncertainty", "any_of": ["uncertain", "may read", "might read", "could be off", "residual"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "C4_underinflation_consequence",
      "version": "1",
      "required_concepts": [
        { "id": "gap_falsifies_systolic", "any_of": ["start below the gap", "miss the gap", "below the gap", "systolic falsely low", "systolic too low"] },
        { "id": "fast_deflation_bias", "any_of": ["fast deflation", "deflating too fast", "too quickly biases", "read late"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },
    {

      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying_unprompted"
    },
    {
      "prompt_id": "E7_implausible_repeat",
      "version": "1",
      "required_concepts": [
        { "id": "recognises_implausible", "any_of": ["implausible", "does not match", "doesn't match", "inconsistent", "unexpected"] },
        { "id": "repeats", "any_of": ["repeat", "measure again", "retake", "take it again"] }
      ],
      "disqualifying_concepts": [
        { "id": "records_anyway", "any_of": ["record it anyway", "document it and move on"] }
      ],
      "rule": "all_required_no_disqualifying_unprompted"
    },
    {
      "prompt_id": "E8_prior_discrepancy",
      "version": "1",
      "required_concepts": [
        { "id": "compares_prior", "any_of": ["prior value", "previous reading", "documented value", "last reading"] },
        { "id": "action", "any_of": ["repeat", "verify", "notify", "escalate", "report"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "F2_error_attribution",
      "version": "1",
      "required_concepts": [
        { "id": "names_step", "any_of": ["deflation", "inflation", "cuff", "placement", "positioning", "rest", "stethoscope", "reading the dial"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "F4_error_kind",
      "version": "1",
      "required_concepts": [
        { "id": "classifies", "any_of": ["technique", "perceptual", "hearing", "listening", "hand"] }

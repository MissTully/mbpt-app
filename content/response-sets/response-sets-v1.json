{
  "version": "ers-1.0.0",
  "sets": [
    {
      "prompt_id": "A3_positioning_faults",
      "version": "1",
      "required_concepts": [
        { "id": "arm_below_heart_raises", "any_of": ["arm below heart reads high", "below heart raises", "below the heart reads high", "arm low reads high"] },
        { "id": "legs_crossed_raises", "any_of": ["crossed legs raise", "legs crossed raises", "crossing legs raises"] }
      ],
      "disqualifying_concepts": [],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "B3_undersized_direction",
      "version": "1",
      "required_concepts": [
        { "id": "undersized_reads_high", "any_of": ["too small reads high", "undersized reads high", "small cuff reads high", "reads falsely high"] }
      ],
      "disqualifying_concepts": [
        { "id": "undersized_reads_low", "any_of": ["too small reads low", "undersized reads low"] }
      ],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "B3_oversized_direction",
      "version": "1",
      "required_concepts": [
        { "id": "oversized_reads_low", "any_of": ["too large reads low", "oversized reads low", "large cuff reads low"] }
      ],
      "disqualifying_concepts": [
        { "id": "oversized_reads_high", "any_of": ["too large reads high", "oversized reads high"] }
      ],
      "rule": "all_required_no_disqualifying"
    },
    {
      "prompt_id": "B5_boundary_justification",
      "version": "1",
